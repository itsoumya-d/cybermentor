# CyberMentor — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit the .env file to git

# Required: Anthropic API key (get one at https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: Claude model to use (default: claude-haiku-4-5-20251001)
CLAUDE_MODEL=claude-haiku-4-5-20251001

# Optional: server host/port
HOST=0.0.0.0
PORT=8000
